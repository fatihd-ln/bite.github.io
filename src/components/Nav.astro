---
import { useTranslations, getLang, localized, delocalized, LANG_LABELS } from '../i18n';
import type { Lang } from '../i18n';

const t = useTranslations(Astro);
const lang = getLang(Astro.url);

// `transparent` overlays the nav on a hero image: it starts see-through and
// turns solid (bg-ink) once scrolled past the banner. See products page.
const { transparent = false } = Astro.props;

const links = [
  {
    label: t.nav.products,
    href: '/products',
    children: [
      { label: t.nav.bSeries, href: '/products' },
      { label: t.nav.hardware, href: '/hardware' },
    ],
  },
  { label: t.nav.team, href: '/team' },
  { label: t.nav.contact, href: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  return currentPath === localized(href, lang) || currentPath === href;
}

function isActiveBranch(link: { href: string; children?: { href: string }[] }) {
  if (isActive(link.href)) return true;
  return link.children?.some(c => isActive(c.href)) ?? false;
}

const canonical = delocalized(currentPath);
const otherLang: Lang = lang === 'en' ? 'tr' : 'en';
const switcherHref = localized(canonical, otherLang);
---

<header
  id="nav"
  data-transparent={transparent ? 'true' : 'false'}
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-colors duration-300',
    transparent ? 'bg-transparent' : 'bg-ink',
  ]}
>
  <nav class="shell h-16 flex items-center justify-between gap-4">
    <a href={localized('/', lang)} class="text-2xl sm:text-3xl tracking-wide leading-none whitespace-nowrap" style="font-family: 'Saira Extra Condensed', sans-serif;">
      <span class="lowercase font-semibold text-[#2563EB]">bite</span> <span class="font-light text-slate-300">Systems</span>
    </a>

    <ul class="hidden md:flex items-center gap-6 lg:gap-8">
      <li>
        <a
          href="https://youtu.be/LyIpHpMZL9c"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.nav.youtube}
          title={t.nav.youtube}
          class="inline-flex items-center text-slate-300 hover:text-white transition-colors duration-200"
        >
          <svg width="28" height="20" viewBox="0 0 24 17" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" class="translate-y-[3px]">
            <path d="M23.5 2.65a3 3 0 0 0-2.11-2.12C19.51 0 12 0 12 0S4.49 0 2.61.53A3 3 0 0 0 .5 2.65 31.3 31.3 0 0 0 0 8.5a31.3 31.3 0 0 0 .5 5.85 3 3 0 0 0 2.11 2.12C4.49 17 12 17 12 17s7.51 0 9.39-.53a3 3 0 0 0 2.11-2.12A31.3 31.3 0 0 0 24 8.5a31.3 31.3 0 0 0-.5-5.85ZM9.6 12.13 15.84 8.5 9.6 4.87v7.26Z" fill="currentColor"/>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/company/bite-systems-eo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.nav.linkedin}
          title={t.nav.linkedin}
          class="inline-flex items-center text-slate-300 hover:text-white transition-colors duration-200"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true" class="translate-y-[2px]">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </a>
      </li>
      {links.map(link => (
        <li class={link.children ? 'relative group/menu' : ''}>
          {link.children ? (
            <span
              class:list={[
                'text-sm tracking-wide uppercase transition-colors duration-200 inline-flex items-center gap-1 cursor-default select-none',
                isActiveBranch(link) ? 'text-white' : 'text-slate-300 hover:text-white',
              ]}
            >
              {link.label}
              <svg class="w-3 h-3 transition-transform duration-200 group-hover/menu:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          ) : (
            <a
              href={localized(link.href, lang)}
              class:list={[
                'text-sm tracking-wide uppercase transition-colors duration-200 inline-flex items-center gap-1',
                isActiveBranch(link) ? 'text-white' : 'text-slate-300 hover:text-white',
              ]}
            >
              {link.label}
            </a>
          )}

          {link.children && (
            <div class="absolute left-0 top-full pt-3 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-200">
              <ul class="bg-ink border border-white/10 py-2 min-w-[160px] overflow-hidden rounded-lg">
                {link.children.map(child => (
                  <li>
                    <a
                      href={localized(child.href, lang)}
                      class:list={[
                        'block px-4 py-2 text-sm tracking-wide uppercase transition-colors duration-200',
                        isActive(child.href) ? 'text-white' : 'text-slate-300 hover:text-white',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
      <li>
        <a
          href={switcherHref}
          aria-label={`Switch to ${LANG_LABELS[otherLang]}`}
          class="text-sm tracking-wide uppercase text-slate-300 hover:text-white transition-colors duration-200 border border-white/20 hover:border-white/40 px-2 py-1 rounded-md"
        >
          {LANG_LABELS[otherLang]}
        </a>
      </li>
    </ul>

    <div class="md:hidden flex items-center gap-2 -mr-4">
      <a
        href={switcherHref}
        aria-label={`Switch to ${LANG_LABELS[otherLang]}`}
        class="inline-flex items-center justify-center min-w-9 h-10 px-2 text-sm tracking-wide uppercase text-slate-300 hover:text-white transition-colors duration-200 border border-white/20 hover:border-white/40 rounded-md"
      >
        {LANG_LABELS[otherLang]}
      </a>
      <a
        href="https://youtu.be/LyIpHpMZL9c"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.youtube}
        title={t.nav.youtube}
        class="inline-flex items-center justify-center w-10 h-10 text-slate-300 hover:text-white transition-colors duration-200"
      >
        <svg width="26" height="18" viewBox="0 0 24 17" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd">
          <path d="M23.5 2.65a3 3 0 0 0-2.11-2.12C19.51 0 12 0 12 0S4.49 0 2.61.53A3 3 0 0 0 .5 2.65 31.3 31.3 0 0 0 0 8.5a31.3 31.3 0 0 0 .5 5.85 3 3 0 0 0 2.11 2.12C4.49 17 12 17 12 17s7.51 0 9.39-.53a3 3 0 0 0 2.11-2.12A31.3 31.3 0 0 0 24 8.5a31.3 31.3 0 0 0-.5-5.85ZM9.6 12.13 15.84 8.5 9.6 4.87v7.26Z" fill="currentColor"/>
        </svg>
      </a>
      <a
        href="https://www.linkedin.com/company/bite-systems-eo"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.linkedin}
        title={t.nav.linkedin}
        class="inline-flex items-center justify-center w-10 h-10 text-slate-300 hover:text-white transition-colors duration-200"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
        </svg>
      </a>
      <button
        id="nav-toggle"
        type="button"
        aria-label={t.nav.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex items-center justify-center w-10 h-10 text-slate-300 hover:text-white"
      >
        <svg id="nav-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg id="nav-icon-close" class="hidden w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden bg-ink border-t border-white/10">
    <ul class="px-6 py-4 flex flex-col gap-1">
      {links.map(link => (
        <Fragment>
          <li>
            {link.children ? (
              <span class="block py-2 text-sm tracking-wide uppercase text-slate-400 select-none">
                {link.label}
              </span>
            ) : (
              <a
                href={localized(link.href, lang)}
                class:list={[
                  'mobile-link block py-2 text-sm tracking-wide uppercase transition-colors duration-200',
                  isActive(link.href) ? 'text-white' : 'text-slate-300 hover:text-white',
                ]}
              >
                {link.label}
              </a>
            )}
          </li>
          {link.children?.map(child => (
            <li>
              <a
                href={localized(child.href, lang)}
                class:list={[
                  'mobile-link block py-2 pl-4 text-sm tracking-wide uppercase transition-colors duration-200 border-l border-white/10',
                  isActive(child.href) ? 'text-white' : 'text-slate-300 hover:text-white',
                ]}
              >
                {child.label}
              </a>
            </li>
          ))}
        </Fragment>
      ))}
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  const transparent = nav?.dataset.transparent === 'true';

  function setScrolledStyle() {
    const menuOpen = menu ? !menu.classList.contains('hidden') : false;
    // Over a hero, stay see-through until scrolled past most of the banner.
    const solid = !transparent || menuOpen || window.scrollY > window.innerHeight * 0.6;
    if (transparent) {
      nav?.classList.toggle('bg-ink', solid);
      nav?.classList.toggle('bg-transparent', !solid);
    }
    const border = menuOpen || (solid && window.scrollY > 40);
    nav?.classList.toggle('border-b', border);
    nav?.classList.toggle('border-white/10', border);
  }

  window.addEventListener('scroll', setScrolledStyle, { passive: true });
  window.addEventListener('resize', setScrolledStyle);
  setScrolledStyle();

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    setScrolledStyle();
  });

  document.querySelectorAll('#mobile-menu .mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      setScrolledStyle();
    });
  });
</script>
