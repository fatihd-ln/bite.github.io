---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro);
---

<section id="contact" class="pt-10 pb-32">
  <div class="shell">

    <div class="mb-16 max-w-2xl">
      <p class="text-accent text-xs tracking-[0.3em] uppercase mb-4">{t.contact.kicker}</p>
      <h2 class="text-4xl font-light tracking-tight mb-6">
        {t.contact.titlePart1}<span class="font-semibold">{t.contact.titlePart2}</span>
      </h2>
      <p class="text-slate-500 font-light leading-relaxed">
        {t.contact.description}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

      <div class="grid grid-cols-1 gap-10">

        <div class="border-t border-border pt-6">
          <p class="text-muted text-xs uppercase tracking-widest mb-3">{t.contact.emailLabel}</p>
          <div class="flex items-center gap-3">
            <a href="mailto:info@bitesystems.com.tr" class="text-slate-900 text-base font-light hover:text-accent transition-colors break-all">
              info@bitesystems.com.tr
            </a>
            <button
              type="button"
              class="copy-btn shrink-0 inline-flex items-center justify-center w-7 h-7 border border-border text-muted hover:text-slate-900 hover:border-slate-400 transition-colors"
              data-copy="info@bitesystems.com.tr"
              aria-label={t.contact.copyEmail}
              title={t.contact.copyEmail}
            >
              <svg class="icon-copy w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 7.5V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 20.25 6v7.5a2.25 2.25 0 0 1-2.25 2.25h-1.5M15.75 8.25h-9A2.25 2.25 0 0 0 4.5 10.5v9a2.25 2.25 0 0 0 2.25 2.25h9A2.25 2.25 0 0 0 18 19.5v-9a2.25 2.25 0 0 0-2.25-2.25Z" />
              </svg>
              <svg class="icon-check hidden w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
            </button>
          </div>
        </div>

        <div class="border-t border-border pt-6">
          <p class="text-muted text-xs uppercase tracking-widest mb-3">{t.contact.locationLabel}</p>
          <p class="text-slate-900 text-base font-light">{t.contact.locationValue}</p>
        </div>

      </div>

      <div class="border-t border-border pt-6">
        <div class="border border-border bg-card overflow-hidden">
          <iframe
            src={t.contact.mapSrc}
            title={t.contact.mapTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-[320px] block border-0"
            style="filter: grayscale(0.3);"
          ></iframe>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const copyIcon = btn.querySelector('.icon-copy');
      const checkIcon = btn.querySelector('.icon-check');
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 1500);
    });
  });
</script>
