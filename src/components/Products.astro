---
import { useTranslations, getLang, localized } from '../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);

// Non-translatable per-product visual assets, keyed by id.
const assets: Record<string, { image?: string; imageHover?: string; media?: string }> = {
  b270: { image: '/media/b270.png', imageHover: '/media/b270-xray.png' },
  b230: { image: '/media/b1.png', imageHover: '/media/b1-xray.png' },
  b330: { image: '/media/b330.png' },
  'tracker-1': { image: '/media/antenna-tracker.png' },
};

type ProductEntry = {
  id: string;
  name: string;
  tagline: string;
  description: string;
  specs: string[];
  details: { label: string; value: string }[];
  overlay?: string;
};

const groups: { id: string; meta: { kicker: string; title: string; intro: string }; items: ProductEntry[] }[] = [
  { id: 'gimbals', meta: t.products.groups.gimbals, items: t.products.gimbals },
  { id: 'trackers', meta: t.products.groups.trackers, items: t.products.trackers },
];
---

<section id="products" class="pt-32 pb-8 px-6">
  <div class="max-w-6xl mx-auto space-y-32">

    {groups.map(group => (
      <div class="products-group">
        <div class="mb-16">
          <p class="text-accent text-xs tracking-[0.3em] uppercase mb-4">{group.meta.kicker}</p>
          <h2 class="text-4xl font-light tracking-tight [text-shadow:0_0_60px_rgba(255,255,255,0.15)]">{group.meta.title}</h2>
          <p class="text-gray-400 font-light mt-6 leading-relaxed max-w-2xl">{group.meta.intro}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
          {group.items.map(product => {
            const a = assets[product.id] ?? {};
            return (
            <article class="bg-card/55 backdrop-blur-md border-2 border-transparent shadow-[0_5px_15px_-3px_rgba(0,0,0,0.35)] hover:shadow-[0_10px_30px_-5px_rgba(0,0,0,0.7)] transition-shadow duration-300 flex flex-col overflow-hidden">

              <div class="aspect-video overflow-hidden bg-black/[0.11] flex items-center justify-center relative group">
                {a.image ? (
                  <>
                    <img
                      src={a.image}
                      alt={product.name}
                      class={`absolute inset-0 w-full h-full object-contain transition-opacity duration-500 ${a.imageHover ? 'group-hover:opacity-0' : ''}`}
                    />
                    {a.imageHover && (
                      <img
                        src={a.imageHover}
                        alt={`${product.name} internals`}
                        class="absolute inset-0 w-full h-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                      />
                    )}
                  </>
                ) : a.media ? (
                  <video
                    src={a.media}
                    autoplay
                    muted
                    loop
                    playsinline
                    class="w-full h-full object-contain"
                  />
                ) : null}

                {product.overlay && (
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <span class="text-white text-xs sm:text-sm font-semibold tracking-[0.4em] uppercase border border-white/30 px-4 py-2 bg-black/30 backdrop-blur-[2px]">
                      {product.overlay}
                    </span>
                  </div>
                )}
              </div>

              <div class="p-6 flex-1 min-h-[300px] flex flex-col">
                <div class="flex items-baseline justify-between mb-2">
                  <h3 class="font-product text-2xl font-semibold tracking-wide">{product.name}</h3>
                  <span class="text-xs text-muted uppercase tracking-widest">{product.tagline}</span>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed">{product.description}</p>
                <ul class="flex flex-wrap gap-2 mt-auto pt-6">
                  {product.specs.map(spec => (
                    <li class="text-sm text-muted border border-border px-2.5 py-1.5 tracking-wide">{spec}</li>
                  ))}
                </ul>
              </div>

              {product.details && product.details.length > 0 && (
                <details class="group/details border-t border-border">
                  <summary class="px-6 py-4 cursor-pointer text-xs uppercase tracking-widest text-gray-300 hover:text-white transition-colors flex items-center justify-between list-none [&::-webkit-details-marker]:hidden">
                    <span>{t.products.specifications}</span>
                    <svg
                      class="w-4 h-4 text-muted transition-transform duration-300 group-open/details:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </summary>
                  <div class="px-6 pt-2">
                    {product.details.map((d, i) => (
                      <div class={`flex items-baseline justify-between gap-4 py-2.5 ${i < product.details.length - 1 ? 'border-b border-border' : ''}`}>
                        <span class="text-muted text-xs uppercase tracking-widest">{d.label}</span>
                        <span class="text-sm text-white font-light text-right whitespace-pre-line">{d.value}</span>
                      </div>
                    ))}
                  </div>
                  <button
                    type="button"
                    class="close-specs group/close w-full flex flex-col items-center gap-0.5 px-6 pt-3 pb-1.5 mt-2 cursor-pointer"
                    aria-label={t.products.closeSpecs}
                    title={t.products.closeSpecs}
                  >
                    <svg
                      class="w-3 h-3 text-muted transition-colors group-hover/close:text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
                    </svg>
                    <span class="w-[90%] h-px bg-border transition-colors group-hover/close:bg-white/40"></span>
                  </button>
                </details>
              )}

            </article>
          )})}
        </div>

      </div>
    ))}

    <div class="pt-6 border-t border-border flex justify-end">
      <a
        href={localized('/hardware', lang)}
        class="group inline-flex items-center gap-3 text-lg tracking-wide uppercase text-gray-400 hover:text-white transition-colors"
      >
        <span>{t.nav.hardware}</span>
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.close-specs').forEach((btn) => {
    btn.addEventListener('click', () => {
      const details = btn.closest('details');
      if (!details) return;
      details.removeAttribute('open');
      // Bring the (now collapsed) drawer summary back into view.
      details.querySelector('summary')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
