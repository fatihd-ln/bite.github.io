---
import { useTranslations, getLang, localized } from '../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);

// Non-translatable per-product visual assets, keyed by id.
const assets: Record<string, { image?: string; imageHover?: string; media?: string; scale?: string }> = {
  b270: { image: '/media/b270.webp', imageHover: '/media/b270-xray.webp', scale: 'scale-[0.84] lg:scale-[0.95]' },
  b230: { image: '/media/b1.webp', imageHover: '/media/b1-xray.webp', scale: 'scale-[0.66]' },
  b330: { image: '/media/b330.webp', scale: 'scale-[0.70] lg:scale-[0.66]' },
  'tracker-1': { image: '/media/antenna-tracker.webp', imageHover: '/media/antenna-tracker-plain.webp', scale: 'scale-[1.0]' },
};

type ProductEntry = {
  id: string;
  name: string;
  tagline: string;
  description: string;
  specs: string[];
  details: { label: string; value: string }[];
  overlay?: string;
};

const groups: { id: string; meta: { kicker: string; title: string; intro: string }; items: ProductEntry[] }[] = [
  { id: 'gimbals', meta: t.products.groups.gimbals, items: t.products.gimbals },
  { id: 'trackers', meta: t.products.groups.trackers, items: t.products.trackers },
];
---

<section id="products" class="pt-14 pb-8">
  <div class="shell space-y-20">

    {groups.map(group => (
      <div class="products-group">
        <div class="mb-14">
          <p class="text-accent text-xs tracking-[0.3em] uppercase mb-4">{group.meta.kicker}</p>
          <h2 class="text-4xl font-light tracking-tight">{group.meta.title}</h2>
          <p class="text-slate-500 font-light mt-6 leading-relaxed max-w-2xl">{group.meta.intro}</p>
        </div>

        <div class="space-y-8">
          {group.items.map(product => {
            const a = assets[product.id] ?? {};
            const hasImages = !!a.image;
            const hasTwo = !!a.imageHover;
            return (
            <article class="flex flex-col lg:flex-row overflow-hidden">

              {/* Left: 4:3 image box. Fills the column width (so its side
                  margins match the text); height is capped, so on wide vertical
                  layouts the ratio frees out to letterbox instead of leaving
                  big side gaps. Same rule as the header. */}
              <div class="product-media lg:w-[34%] shrink-0 lg:flex lg:items-start">
                <div class="group relative w-full aspect-[16/15] max-h-[300px] lg:max-h-[439px] bg-[#e9edf4] overflow-hidden">
                  {/* Only this layer scales on hover — badge, arrows, dots stay put */}
                  <div class="absolute inset-0 transition-transform duration-300 ease-out lg:group-hover:scale-[1.035]">
                  {hasImages ? (
                    <>
                      <img
                        src={a.image}
                        alt={product.name}
                        decoding="async"
                        loading="lazy"
                        class={`media-img absolute inset-0 w-full h-full object-contain transition-opacity duration-500 opacity-100 ${a.scale ?? ''}`}
                      />
                      {hasTwo && (
                        <img
                          src={a.imageHover}
                          alt={`${product.name} internals`}
                          decoding="async"
                          loading="lazy"
                          class={`media-img absolute inset-0 w-full h-full object-contain transition-opacity duration-500 opacity-0 ${a.scale ?? ''}`}
                        />
                      )}
                    </>
                  ) : a.media ? (
                    <video src={a.media} autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-contain" />
                  ) : null}
                  </div>

                  {product.tagline && (
                    <span class={`absolute top-4 right-4 text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 ${product.overlay ? 'bg-ink text-slate-200' : 'bg-accent text-white'}`}>
                      {product.tagline}
                    </span>
                  )}

                  {hasTwo && (
                    <>
                      <button type="button" class="media-prev hidden md:block absolute left-2.5 top-1/2 -translate-y-1/2 z-10 p-2 text-slate-400 hover:text-slate-600 transition-colors" aria-label="Previous image">
                        <svg class="w-6 h-6 drop-shadow-[0_1px_1px_rgba(255,255,255,0.5)]" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><polygon points="7.5,1 7.5,9 1.5,5" /></svg>
                      </button>
                      <button type="button" class="media-next hidden md:block absolute right-2.5 top-1/2 -translate-y-1/2 z-10 p-2 text-slate-400 hover:text-slate-600 transition-colors" aria-label="Next image">
                        <svg class="w-6 h-6 drop-shadow-[0_1px_1px_rgba(255,255,255,0.5)]" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><polygon points="2.5,1 2.5,9 8.5,5" /></svg>
                      </button>
                      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex gap-2">
                        <span class="media-dot w-6 h-0.5 bg-accent cursor-pointer"></span>
                        <span class="media-dot w-6 h-0.5 bg-slate-300 cursor-pointer"></span>
                      </div>
                    </>
                  )}
                </div>
              </div>

              {/* Right: tags, name, description, key specs */}
              <div class="flex-1 py-8 lg:p-8 flex flex-col">
                <div class="h-px bg-border mb-5 lg:-mt-8"></div>
                {product.specs && product.specs.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    {product.specs.map(spec => (
                      <span class="text-[11px] uppercase tracking-wider text-slate-600 bg-[#e9edf4] px-2 py-1">{spec}</span>
                    ))}
                  </div>
                )}

                <h3 class="font-product text-[33px] font-semibold tracking-wide mb-2">{product.name}</h3>

                <p class="text-slate-700 text-[15px] leading-snug mb-4">{product.description}</p>

                {product.details && product.details.length > 0 && (
                  <div>
                    <div class="mb-4">
                      <p class="text-[11px] uppercase tracking-[0.2em] text-accent font-semibold">{t.products.specifications}</p>
                    </div>
                    <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-2.5">
                      {product.details.map((d, i) => (
                        <li class:list={['flex gap-2.5 text-sm leading-snug', product.id === 'b270' && i === product.details.length - 1 && 'sm:col-start-2']}>
                          <span class="mt-[7px] w-1.5 h-1.5 bg-accent shrink-0"></span>
                          <span class="text-slate-700">
                            <span class="text-slate-900 font-medium">{d.label}</span>
                            <span class="whitespace-pre-line">: {d.value}</span>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

            </article>
          )})}
        </div>

      </div>
    ))}

    {/* Closing call-to-action */}
    <div class="pt-14 flex flex-col items-center text-center gap-5">
      <p class="text-3xl font-light tracking-tight">{t.products.learnMore}</p>
      <div class="flex items-center gap-8">
        <a
          href={localized('/contact', lang)}
          class="group inline-flex items-center gap-2 text-lg tracking-wide uppercase text-accent hover:text-blue-700 transition-colors"
        >
          <span>{t.nav.contact}</span>
          <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
        <a
          href={localized('/hardware', lang)}
          class="group inline-flex items-center gap-2 text-sm tracking-wide uppercase text-slate-500 hover:text-slate-900 transition-colors"
        >
          <span>{t.nav.hardware}</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.product-media').forEach(media => {
    const imgs = Array.from(media.querySelectorAll<HTMLElement>('.media-img'));
    if (imgs.length < 2) return;
    const dots = Array.from(media.querySelectorAll<HTMLElement>('.media-dot'));
    let idx = 0;
    const show = (i: number) => {
      idx = (i + imgs.length) % imgs.length;
      imgs.forEach((im, n) => { im.style.opacity = n === idx ? '1' : '0'; });
      dots.forEach((d, n) => {
        d.classList.toggle('bg-accent', n === idx);
        d.classList.toggle('bg-slate-300', n !== idx);
      });
    };
    media.querySelector('.media-prev')?.addEventListener('click', () => show(idx - 1));
    media.querySelector('.media-next')?.addEventListener('click', () => show(idx + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => show(n)));

    // Touch swipe (mobile): horizontal swipe switches image; vertical scroll untouched.
    let sx = 0, sy = 0;
    media.addEventListener('touchstart', (e: TouchEvent) => {
      sx = e.touches[0].clientX; sy = e.touches[0].clientY;
    }, { passive: true });
    media.addEventListener('touchend', (e: TouchEvent) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(dx < 0 ? idx + 1 : idx - 1);
    }, { passive: true });
  });
</script>
