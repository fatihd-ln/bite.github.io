---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro);
---

<section id="who" class="relative overflow-hidden py-32 px-6">

  <img
    src="/media/b270-front.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none select-none absolute top-0 right-[4%] w-[28%] max-w-[480px] opacity-20"
  />

  <div class="relative max-w-6xl mx-auto">

    <div class="mb-16 max-w-2xl">
      <p class="text-[#c8a96e] text-xs tracking-[0.3em] uppercase mb-4">{t.team.kicker}</p>
      <h2 class="text-4xl font-light tracking-tight [text-shadow:0_0_60px_rgba(255,255,255,0.15)]">{t.team.title}</h2>
      <p class="text-gray-400 font-light mt-6 leading-relaxed">
        {t.team.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {t.team.members.map(m => (
        <div class="border-t border-border pt-6">
          <h3 class="text-lg font-semibold tracking-tight">{m.name}</h3>
          <p class="text-[#c8a96e] text-xs uppercase tracking-widest mt-1 mb-4">{m.role}</p>
          <p class="text-gray-400 font-light text-sm leading-relaxed">{m.bio}</p>
        </div>
      ))}
    </div>

  </div>
</section>
