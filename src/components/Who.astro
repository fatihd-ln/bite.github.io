---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro);
---

<section id="who" class="relative overflow-hidden pt-10 pb-32">

  <div class="shell relative">

    <div class="mb-16 max-w-2xl">
      <p class="text-[#a8833c] text-xs tracking-[0.3em] uppercase mb-4">{t.team.kicker}</p>
      <h2 class="text-4xl font-light tracking-tight">{t.team.title}</h2>
      <p class="text-slate-600 font-light mt-6 leading-relaxed">
        {t.team.description}
      </p>
    </div>

    <div class="flex flex-col lg:flex-row lg:flex-wrap gap-x-16 gap-y-10">
      {t.team.members.map(m => (
        <div class="w-fit">
          <div class="border-t border-border w-24"></div>
          <h3 class="pt-6 text-lg font-semibold tracking-tight">{m.name}</h3>
          <p class="w-0 min-w-full text-[#a8833c] text-xs uppercase tracking-widest mt-2">{m.role}</p>
        </div>
      ))}
    </div>

  </div>
</section>
