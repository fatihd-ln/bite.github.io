---
import { useTranslations, getLang, localized } from '../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);
---

<section class="relative min-h-screen flex flex-col pt-16 overflow-hidden lg:overflow-visible">
  <div class="shell grid grid-cols-1 lg:grid-cols-2 gap-16 items-center pt-12 pb-24 lg:py-24 flex-1">

    <div class="relative z-10 lg:-translate-y-12">
      <p class="text-accent text-sm font-bold tracking-[0.15em] uppercase mb-8 lg:mb-6">{t.hero.kicker}</p>
      <h1 class="text-[2.75rem] lg:text-6xl font-light leading-tight mb-6 tracking-tight">
        <Fragment set:html={t.hero.h1Line1} /><br />
        {t.hero.h1Line2}<br />
        <span class="font-semibold">{t.hero.h1Line3}</span>
      </h1>
      <p class="text-slate-500 text-lg font-light leading-relaxed max-w-md mb-6 lg:mb-10">
        {t.hero.description}
      </p>
      <div class="flex items-center gap-6">
        <a
          href={localized('/products', lang)}
          class="font-product px-8 py-3 bg-accent text-white text-lg font-semibold tracking-wide uppercase hover:bg-blue-700 transition-colors duration-200 rounded-md"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href={localized('/contact', lang)}
          class="text-sm text-slate-500 hover:text-slate-900 tracking-wide uppercase transition-colors duration-200"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="absolute inset-0 z-0 opacity-40 pointer-events-none lg:relative lg:inset-auto lg:z-auto lg:opacity-100 lg:pointer-events-auto lg:aspect-square lg:-translate-y-8">
      <video
        id="hero-video"
        autoplay
        muted
        loop
        playsinline
        class="w-full h-full object-contain scale-[1.3] lg:scale-[0.9375] translate-y-0 lg:translate-y-[calc(-10%_+_1cm)]"
      >
        <source src="/media/gimbal1.webm" type="video/webm" />
        <source src="/media/gimbal1.mp4" type="video/mp4" />
      </video>
    </div>

  </div>
</section>
