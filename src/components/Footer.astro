---
import { useTranslations, getLang, localized } from '../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);
const year = new Date().getFullYear();
---

<footer class="border-t border-border px-6 py-10">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 items-center gap-4 text-muted text-sm">
    <span class="text-xl text-white leading-none text-center md:text-left" style="font-family: 'Saira Extra Condensed', sans-serif;">
      <span class="lowercase font-semibold text-[#2563EB]">bite</span> <span class="font-light text-gray-300">Systems</span>
    </span>
    <span class="text-center">{t.footer.copy(year)}</span>
    <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center md:justify-end">
      <a href={localized('/products', lang)} class="hover:text-white transition-colors">{t.nav.products}</a>
      <a href={localized('/hardware', lang)} class="hover:text-white transition-colors">{t.nav.hardware}</a>
      <a href={localized('/team', lang)} class="hover:text-white transition-colors">{t.nav.team}</a>
      <a href={localized('/contact', lang)} class="hover:text-white transition-colors">{t.nav.contact}</a>
    </div>
  </div>
</footer>
