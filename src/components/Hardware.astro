---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro);
const v = t.hardware.vision;
---

<section id="hardware" class="pt-10 pb-32">
  <div class="shell space-y-32">

    <div>

      <div class="mb-16 max-w-2xl">
        <p class="text-accent text-xs tracking-[0.15em] uppercase mb-4">{t.hardware.kicker}</p>
        <h2 class="text-4xl font-light tracking-tight">
          {t.hardware.title}
        </h2>
        <p class="text-slate-500 font-light mt-6 leading-relaxed">
          {t.hardware.description}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px mb-16 max-w-3xl bg-border border border-border overflow-hidden rounded-lg">
        {t.hardware.stats.map(s => (
          <div class="bg-card px-6 py-4 text-center">
            <p class="text-2xl font-light text-slate-900">
              {s.value}<span class="text-accent text-base ml-1 font-mono">{s.unit}</span>
            </p>
            <p class="text-muted text-xs uppercase tracking-widest mt-2">{s.label}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">

        <div class="space-y-1 order-2 lg:order-1">
          {t.hardware.callouts.map(c => (
            <div class="flex items-baseline justify-between gap-4 py-3 border-b border-border">
              <span class="text-muted text-xs uppercase tracking-widest">{c.label}</span>
              <span class="text-sm text-slate-900 font-light text-right">{c.value}</span>
            </div>
          ))}
          {t.hardware.pcbDescription && (
            <p class="text-slate-500 font-light text-sm leading-relaxed pt-6">
              {t.hardware.pcbDescription}
            </p>
          )}
        </div>

        <div class="order-1 lg:order-2">
          <img
            src="/media/pcb-v1.2.webp"
            alt={t.hardware.pcbCaption}
            width="1100"
            height="802"
            decoding="async"
            loading="lazy"
            class="w-3/4 h-auto max-h-[265px] mx-auto lg:mr-0 lg:ml-auto object-contain"
          />
          <p class="text-muted text-xs tracking-widest uppercase mt-8 w-3/4 mx-auto lg:mr-0 lg:ml-auto text-center">{t.hardware.pcbCaption}</p>
        </div>

      </div>
    </div>

    <div id="vision">

      <div class="mb-16 max-w-2xl">
        <p class="text-accent text-xs tracking-[0.15em] uppercase mb-4">{v.kicker}</p>
        <h2 class="text-4xl font-light tracking-tight">
          {v.title}
        </h2>
        <p class="text-slate-500 font-light mt-6 leading-relaxed">
          {v.description}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px mb-16 max-w-3xl bg-border border border-border overflow-hidden rounded-lg">
        {v.stats.map(s => (
          <div class="bg-card px-6 py-5 text-center">
            <p class="text-xl font-light text-slate-900">{s.value}</p>
            <p class="text-accent text-xs uppercase tracking-widest mt-1 font-mono">{s.sub}</p>
            <p class="text-muted text-xs uppercase tracking-widest mt-1">{s.label}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">

        <div class="space-y-1 order-2 lg:order-1">
          {v.callouts.map(c => (
            <div class="flex items-baseline justify-between gap-4 py-3 border-b border-border">
              <span class="text-muted text-xs uppercase tracking-widest">{c.label}</span>
              <span class="text-sm text-slate-900 font-light text-right">{c.value}</span>
            </div>
          ))}
          {v.closingDescription && (
            <p class="text-slate-500 font-light text-sm leading-relaxed pt-6">
              {v.closingDescription}
            </p>
          )}
        </div>

        <div class="order-1 lg:order-2">
          <div
            role="img"
            aria-label={v.imageCaption}
            class="relative w-3/4 h-auto aspect-[1202/850] mx-auto lg:mr-0 lg:ml-auto bg-[#0d0d0d] border border-border overflow-hidden rounded-2xl"
          >
            <img
              src="/media/vision-schematic.webp"
              alt=""
              aria-hidden="true"
              decoding="async"
              loading="lazy"
              class="absolute inset-0 w-full h-full object-contain opacity-75"
            />
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-white text-xs sm:text-sm font-semibold tracking-[0.4em] uppercase border border-white/30 px-4 py-2 bg-black/55 rounded-md">
                {v.comingSoon}
              </span>
            </div>
          </div>
          <p class="text-muted text-xs tracking-widest uppercase mt-8 w-3/4 mx-auto lg:mr-0 lg:ml-auto text-center">{v.imageCaption}</p>
        </div>

      </div>
    </div>

  </div>
</section>
