<div aria-hidden="true" class="bg-fx"></div>

<style>
  /* Soft ambient glow behind all content. Baked as static radial-gradients
     (no filter/animation/compositor layers) so it costs nothing per frame
     while scrolling. */
  .bg-fx {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    background:
      radial-gradient(46vw 46vw at 12% 4%,  rgba(37, 99, 235, 0.14), transparent 60%),
      radial-gradient(40vw 40vw at 95% 45%, rgba(59, 130, 246, 0.16), transparent 60%),
      radial-gradient(38vw 38vw at 40% 96%, rgba(96, 165, 250, 0.16), transparent 60%);
  }
</style>
