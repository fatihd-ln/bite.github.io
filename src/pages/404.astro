---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getLang, localized } from '../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);
---

<Layout title="404 — bite Systems" description="Page not found." noindex={true}>
  <Nav />
  <main class="pt-16 min-h-screen flex items-center">
    <div class="shell text-center py-32">
      <p class="text-accent text-sm font-bold tracking-[0.15em] uppercase mb-6">Error 404</p>
      <h1 class="text-6xl sm:text-7xl font-light tracking-tight mb-6">
        Page not found.
      </h1>
      <p class="text-slate-500 text-lg font-light leading-relaxed max-w-md mx-auto mb-2">
        The page you’re looking for doesn’t exist or has moved.
      </p>
      <p class="text-muted text-sm font-light leading-relaxed max-w-md mx-auto mb-10">
        Aradığınız sayfa bulunamadı ya da taşınmış.
      </p>
      <div class="flex items-center justify-center gap-6">
        <a
          href={localized('/', lang)}
          class="font-product px-8 py-3 bg-accent text-white text-lg font-semibold tracking-wide uppercase hover:bg-blue-700 transition-colors duration-200 rounded-md"
        >
          {t.nav.home}
        </a>
        <a
          href={localized('/products', lang)}
          class="group inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-900 tracking-wide uppercase transition-colors duration-200"
        >
          <span>{t.nav.products}</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
