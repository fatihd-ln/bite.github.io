---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Who from '../../components/Who.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, getLang, localized } from '../../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);
---

<Layout title={t.meta.team.title} description={t.meta.team.description}>
  <Nav />
  <main class="pt-16 relative overflow-hidden">
    <img
      src="/media/b270-front.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none select-none absolute top-16 right-[4%] z-0 w-[56%] sm:w-[28%] max-w-[480px] opacity-20 blur-[1px]"
    />
    <div class="relative z-10">
      <Breadcrumb items={[{ label: t.nav.home, href: localized('/', lang) }, { label: t.nav.team }]} />
      <Who />
    </div>
  </main>
  <Footer />
</Layout>
