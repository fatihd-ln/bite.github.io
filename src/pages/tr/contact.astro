---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, getLang, localized } from '../../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);
---

<Layout title={t.meta.contact.title} description={t.meta.contact.description}>
  <Nav />
  <main class="pt-16">
    <Breadcrumb items={[{ label: t.nav.home, href: localized('/', lang) }, { label: t.nav.contact }]} />
    <Contact />
  </main>
  <Footer />
</Layout>
