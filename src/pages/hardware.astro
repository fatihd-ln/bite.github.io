---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Hardware from '../components/Hardware.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getLang, localized } from '../i18n';
const t = useTranslations(Astro);
const lang = getLang(Astro.url);
---

<Layout title={t.meta.hardware.title} description={t.meta.hardware.description}>
  <Nav />
  <main class="pt-16">
    <Breadcrumb items={[{ label: t.nav.home, href: localized('/', lang) }, { label: t.nav.products, href: localized('/products', lang) }, { label: t.nav.hardware }]} />
    <Hardware />
  </main>
  <Footer />
</Layout>
